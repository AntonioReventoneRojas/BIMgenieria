  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "Dynamo.Graph.Nodes.ZeroTouch.DSFunction, DynamoCore",
      "NodeType": "FunctionNode",
      "FunctionSignature": "Revit.Elements.Element.Solids",
      "Id": "8a00b9fec8c248f7a97d278e31b66052",
      "Inputs": [
        {
          "Id": "f8d5c74537d8427490fcf835c40f9631",
          "Name": "element",
          "Description": "Revit.Elements.Element",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "3743104080f14b6ebd5460cab8fdc392",
          "Name": "Solid[]",
          "Description": "Solid[]",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Auto",
      "Description": "The Solids in this Element\n\nElement.Solids: Solid[]"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import clr\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nclr.AddReference('RevitServices')\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\n# Get the current document\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# Input duct fitting(s) from Dynamo\r\ninput_fittings = UnwrapElement(IN[0])\r\n\r\n# Ensure input_fittings is a list\r\nif not isinstance(input_fittings, list):\r\n    input_fittings = [input_fittings]\r\n\r\n# Initialize lists to store the widths, heights, and diameters\r\nwidths = []\r\nheights = []\r\ndiameters = []\r\n\r\n# Iterate over each fitting\r\nfor fitting in input_fittings:\r\n    mechanical_fitting = fitting.MEPModel\r\n    connectors = mechanical_fitting.ConnectorManager.Connectors\r\n    \r\n    # Iterate over each connector to determine its shape and properties\r\n    for connector in connectors:\r\n        # Check if the connector is rectangular/oval or round\r\n        if connector.Shape == ConnectorProfileType.Rectangular or connector.Shape == ConnectorProfileType.Oval:\r\n            height = connector.Height if hasattr(connector, 'Height') else 0\r\n            width = connector.Width if hasattr(connector, 'Width') else 0\r\n            diameter = 0  # Rectangular/oval connectors do not have a diameter\r\n        elif connector.Shape == ConnectorProfileType.Round:\r\n            height = 0  # Round connectors do not have a height\r\n            width = 0  # Round connectors do not have a width\r\n            diameter = connector.Radius * 2 if hasattr(connector, 'Radius') else 0  # Diameter is twice the radius\r\n        else:\r\n            # In case of an unknown shape, set all values to 0\r\n            height = 0\r\n            width = 0\r\n            diameter = 0\r\n\r\n        # Append the values to the respective lists\r\n        heights.append(height)\r\n        widths.append(width)\r\n        diameters.append(diameter)\r\n\r\n# Output the lists of widths, heights, and diameters\r\nOUT = [widths, heights, diameters]",
      "Engine": "IronPython2",
      "VariableInputPorts": true,
      "Id": "a2f4cee431a34cc0917ff1eb866dd663",
      "Inputs": [
        {
          "Id": "fdd75c21f60a44afbef2196057d02d60",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "8c5ccddf50e644cf922c7a89f1df301b",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
